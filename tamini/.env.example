SECRET_KEY=your-secret-key-here

# ── Django ─────────────────────────────────────────────────────────────
# Debug mode. Keep False in production — never deploy with DEBUG=True.
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Database ───────────────────────────────────────────────────────────
# Dev default is SQLite. Production MUST use PostgreSQL:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///db.sqlite3
# Production: keep DB connections alive across gunicorn workers (seconds).
DATABASE_CONN_MAX_AGE=60

# ── Redis ──────────────────────────────────────────────────────────────
# Powers the cache and Channels (WebSocket) layer. If Redis is unreachable,
# settings/base.py automatically falls back to in-memory cache/channel layers
# (fine for local dev / a single worker; run Redis in production).
REDIS_URL=redis://127.0.0.1:6379

# ── Image upload optimization ──────────────────────────────────────────
# Uploaded images are resized to IMAGE_MAX_DIMENSION (px) on the longest side
# and re-encoded as WebP at IMAGE_WEBP_QUALITY (0-100) before storage.
IMAGE_MAX_DIMENSION=1000
IMAGE_WEBP_QUALITY=80

# ── Email (Gmail SMTP for dev / Mailgun for production) ────────────────
EMAIL_USER=taminyfood@gmail.com
EMAIL_PASSWORD=your-email-password
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── Media files (Cloudinary for production) ────────────────────────────
# When CLOUDINARY_CLOUD_NAME is set, uploaded images/videos are stored on
# Cloudinary automatically (prod settings). Leave empty to use local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Contact info ───────────────────────────────────────────────────────
CONTACT_PHONE=+963 900 000 000
WHATSAPP_NUMBER=963900000000
INSTAGRAM=https://instagram.com/taminy
FACEBOOK=https://facebook.com/taminy

# ── Google Maps ────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Deployment ─────────────────────────────────────────────────────────
PORT=8000
GUNICORN_WORKERS=2
